# Upstash Redis, used to store shared schedule links (/v/<id>).
# Add the Upstash integration from the Vercel Marketplace and these are set for you.
# Without them, development falls back to an in-memory store and production
# answers 503 on POST /api/share.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
